# Groq LLM API Key (llama-3.1-8b-instant)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Sarvam AI STT Key (Indic languages & English)
SARVAM_API_KEY=your_sarvam_api_key_here

# ElevenLabs STT Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Qdrant Vector Store
QDRANT_HOST=:memory:
QDRANT_COLLECTION=msmarco_xl_chunks

# Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Latency & Guardrail Thresholds
GROUNDING_SIMILARITY_THRESHOLD=0.60
TARGET_PIPELINE_LATENCY_MS=200.0
